            "profile": {
              "bundles": [
                "rt"
              ]
            }
          }
        },
        "patchRaw": "- insert:\n    - id: rt\n      name: rt\n",
        "nodeModules": {
          "rt/package.json": "{\"name\": \"rt\", \"version\": \"1.0.0\", \"main\": \"i.js\", \"dsh\": {\"bundle\": {\"patch\": \"./cordis.patch.yml\"}}, \"dependencies\": {\"scope-copy\": \"npm:@deepseek-ai/dsh-scope@0.1.6-alpha.1\"}}",
          "rt/cordis.patch.yml": "- insert:\n    - id: rt\n      name: rt\n",
          "rt/i.js": "export default {};\n",
