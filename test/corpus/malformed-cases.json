        }
      },
      "expect": {
        "P23": "fail"
      }
    },
    {
      "id": "plugin-depends-on-plugin-control",
      "source": "forum#6789 红队 F5 对照",
      "desc": "同 scope 的另一插件作为依赖（唯一正确写法）→ 不得误报",
      "setup": {
